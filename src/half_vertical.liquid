
<div class="layout layout--col {% if has_pickups %}layout--top{% else %}layout--center{% endif %} gap">
{% unless has_pickups %}
    <div class="title">No Pickups</div>
    <div class="description">Check schedule</div>
{% else %}
    {%- comment -%} Typography hierarchy: title--small + value {%- endcomment -%}
    <div class="flex flex--col flex--center-x gap-xxs mt-xs">
      <div class="title--small">Next Pickup</div>
      <div class="value lg:value--large">
        {% if next.days_until == 0 %}Today
        {% elsif next.days_until == 1 %}Tomorrow
        {% else %}{{ next.days_until }} days
        {% endif %}
      </div>
      <div class="description">{{ next.short }}</div>
    </div>

    {%- comment -%} Icons Grid - 2 columns using flex {%- endcomment -%}
    <div class="flex flex--row flex--wrap flex--center-x gap">
      {% for type in next.types %}
        <div class="flex flex--col flex--center-x gap-xxs">
          <div>
            <img src="data:image/svg+xml;base64,{{ icons[type.icon] }}" alt="{{ type.label }}" width="96" height="96" />
          </div>
          <div class="description">{{ type.label }}</div>
        </div>
      {% endfor %}
    </div>

    {%- comment -%} Next dated notice, e.g. street sweeping {%- endcomment -%}
    {% if notices.size > 0 %}
      <div class="description">{{ notices.first.label }}: {{ notices.first.short }}</div>
    {% endif %}
{% endunless %}
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ icon_recycling }}" alt="" />
  <span class="title">Waste Collection</span>
  {% if has_pickups %}<span class="instance">{{ next.short }}</span>{% endif %}
</div>
