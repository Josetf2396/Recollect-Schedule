<div class="layout layout--col {% if has_pickups %}layout--top{% else %}layout--center{% endif %} gap">
{% unless has_pickups %}
    <div class="title">No Pickups</div>
    <div class="description">Check schedule</div>
{% else %}
    {%- comment -%} Compact single-line header {%- endcomment -%}
    <div class="flex flex--col flex--center-x mt-xs">
      <div class="title lg:title--large">
        Next Pickup:
        {% if next.days_until == 0 %}Today
        {% elsif next.days_until == 1 %}Tomorrow
        {% else %}In {{ next.days_until }} days
        {% endif %}
        ({{ next.short }})
      </div>
    </div>

    {%- comment -%} Horizontal row of icons {%- endcomment -%}
    <div class="flex flex--row flex--center-x flex--wrap portrait:flex--wrap gap">
      {% for type in next.types %}
        <div class="flex flex--col flex--center-x gap-xxs">
          <img src="data:image/svg+xml;base64,{{ icons[type.icon] }}" alt="{{ type.label }}" width="80" height="80" />
          <div class="description">{{ type.label }}</div>
        </div>
      {% endfor %}
    </div>

    {%- comment -%} Next dated notice, e.g. street sweeping {%- endcomment -%}
    {% if notices.size > 0 %}
      <div class="description">{{ notices.first.label }}: {{ notices.first.medium }}</div>
    {% endif %}
{% endunless %}
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ icon_recycling }}" alt="" />
  <span class="title">Waste Collection</span>
  {% if has_pickups %}<span class="instance">{{ next.short }}</span>{% endif %}
</div>
