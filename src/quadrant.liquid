{% comment %}
  Recollect Schedule Plugin - Quarter View
  Ultra-compact for 2x2 grid mashups - optimized for icon-first display

  Data is precomputed in src/transform.js; this view only lays it out.
{% endcomment %}

{% unless has_pickups %}
  <div class="flex flex--col flex--center gap">
    <div class="description">No Pickups</div>
  </div>
{% else %}
  <div class="layout layout--col layout--top gap">
    {%- comment -%} Compact header {%- endcomment -%}
    <div class="flex flex--col flex--center-x gap-xxs mt-xs">
      <div class="title--small">Pickup</div>
      <div class="value value--small">
        {% if next.days_until == 0 %}Today
        {% elsif next.days_until == 1 %}Tmrw
        {% else %}{{ next.days_until }}d
        {% endif %}
      </div>
    </div>

    {%- comment -%} Icon row with compact spacing and labels {%- endcomment -%}
    <div class="flex flex--row flex--wrap flex--center-x gap-xs">
      {% for type in next.types %}
        <div class="flex flex--col flex--center-x gap-xxs">
          <img src="data:image/svg+xml;base64,{{ icons[type.icon] }}" alt="{{ type.label }}" width="72" height="72" />
          <div class="description text--sm">{{ type.label }}</div>
        </div>
      {% endfor %}
    </div>

    {%- comment -%} Next dated notice, e.g. street sweeping {%- endcomment -%}
    {% if notices.size > 0 %}
      <div class="description text--sm">{{ notices.first.label }}: {{ notices.first.short }}</div>
    {% endif %}
  </div>

  <div class="title_bar">
    <img src="data:image/svg+xml;base64,{{ icon_recycling }}" width="24" height="24" alt="" />
    <span class="title">Waste Collection</span>
    <span class="instance">{{ next.short }}</span>
  </div>
{% endunless %}
