<div class="layout layout--col {% if has_pickups %}layout--top{% else %}layout--center{% endif %} gap">
{% unless has_pickups %}
    <div class="description">No Pickups</div>
{% else %}
    {%- comment -%} Compact header {%- endcomment -%}
    <div class="flex flex--col flex--center-x gap--small mt--1">
      <div class="title--small">Pickup</div>
      <div class="value value--small lg:value--base">
        {% if next.days_until == 0 %}Today
        {% elsif next.days_until == 1 %}Tmrw
        {% else %}{{ next.days_until }}d
        {% endif %}
      </div>
    </div>

    {%- comment -%} Icon row with compact spacing and labels {%- endcomment -%}
    <div class="flex flex--row flex--wrap flex--center-x gap--small">
      {% for type in next.types %}
        <div class="flex flex--col flex--center-x gap--small">
          <img src="data:image/svg+xml;base64,{{ icons[type.icon] }}" alt="{{ type.label }}" width="72" height="72" />
          <div class="description text--small">{{ type.label }}</div>
        </div>
      {% endfor %}
    </div>

    {%- comment -%} Next dated notice, e.g. street sweeping {%- endcomment -%}
    {% if notices.size > 0 %}
      <div class="description text--small">{{ notices.first.label }}: {{ notices.first.short }}</div>
    {% endif %}
{% endunless %}
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ icon_recycling }}" alt="" />
  <span class="title">Waste Collection</span>
  {% if has_pickups %}<span class="instance">{{ next.short }}</span>{% endif %}
</div>
